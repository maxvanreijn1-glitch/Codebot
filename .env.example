# Copy this file to server/.env and fill in your values

# PostgreSQL connection string (from Render or local)
DATABASE_URL=postgresql://postgres:password@localhost:5432/codebot

# JWT signing secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Anthropic / Claude API key
ANTHROPIC_API_KEY=sk-ant-...

# Stripe payment keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Server port (Render sets this automatically)
PORT=5000

# Comma-separated list of allowed CORS origins in production
# Leave empty to allow all origins in development
CORS_ORIGIN=https://your-app.onrender.com

# Local repository storage path
LOCAL_REPOS_PATH=/tmp/local-repos

# Pull request settings
PR_REVIEW_REQUIRED=true

# Timeout for CLI commands (ms)
COMMAND_TIMEOUT=30000

# Debounce delay for copilot suggestions (ms)
SUGGESTION_DEBOUNCE=1000
