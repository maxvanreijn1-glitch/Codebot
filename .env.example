# ============================================================
# Codebot – Environment Configuration
# Copy this file to server/.env and fill in your values.
# In production (Render) set these as environment variables.
# ============================================================

# --- Database --------------------------------------------------
# PostgreSQL connection string.
# On Render this is injected automatically from the linked database.
DATABASE_URL=postgresql://postgres:password@localhost:5432/codebot

# --- Authentication --------------------------------------------
# JWT signing secret. Use a long random string in production (32+ chars).
JWT_SECRET=change-me-to-a-long-random-secret

# --- AI Service ------------------------------------------------
# Anthropic API key for Claude.
# Obtain from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Payments (optional) ---------------------------------------
# Stripe API keys. Obtain from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Stripe webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Server ----------------------------------------------------
# Server port. Render sets PORT automatically; leave as 5000 for local dev.
PORT=5000

# Comma-separated list of allowed CORS origins in production.
# Example: https://your-app.onrender.com
# Leave empty to allow all origins in development.
CORS_ORIGIN=

# --- Local Repository Storage ----------------------------------
LOCAL_REPOS_PATH=/tmp/local-repos

# --- Pull Request Settings -------------------------------------
PR_REVIEW_REQUIRED=true

# --- Performance -----------------------------------------------
# Timeout for CLI commands (milliseconds)
COMMAND_TIMEOUT=30000
# Debounce delay for copilot suggestions (milliseconds)
SUGGESTION_DEBOUNCE=1000
