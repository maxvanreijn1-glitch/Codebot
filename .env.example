# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/codebot

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here

# ─── Claude / Anthropic ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_PREMIUM=price_...

# ─── Client URL (for Stripe redirects) ───────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── Optional: Local repos / commands ────────────────────────────────────────
LOCAL_REPOS_PATH=/path/to/local/repos
PR_REVIEW_REQUIRED=true
COMMAND_TIMEOUT=30000
SUGGESTION_DEBOUNCE=1000
